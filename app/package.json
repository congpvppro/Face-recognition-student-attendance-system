{
  "name": "art-ecommerce",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "api/*",
    "ui/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run --cwd ui/web dev\" \"bun run --cwd api dev\"",
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "build": "bun --filter web build",
    "lint": "biome check --write . && prettier . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "^1.3.4",
    "concurrently": "^9.2.1",
    "prettier": "3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/josefin-sans": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource-variable/raleway": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@fontsource/cormorant-sc": "^5.2.8",
    "dotenv": "^17.2.3",
    "ky": "^1.14.1",
    "tsx": "^4.21.0"
  }
}
